# Endlessync Backend Configuration

# Server Port (Render injects process.env.PORT automatically)
PORT=3000

# MongoDB Connection String (leave empty for in-memory mode)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/endlessync?retryWrites=true&w=majority

# Keep-Awake Self-Ping URL (Render provides RENDER_EXTERNAL_URL automatically; or provide your custom Render URL, e.g. https://your-endlessync-app.onrender.com/ping)
PING_URL=
